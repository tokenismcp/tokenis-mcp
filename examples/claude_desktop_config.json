{
  "mcpServers": {
    "tokenis": {
      "command": "uvx",
      "args": [
        "tokenis-mcp",
        "serve",
        "--config",
        "/absolute/path/to/tokenis.toml"
      ],
      "env": {
        "TOKENIS_TOKENIZER_KEY": "<64 hex chars from `tokenis-mcp keygen-secret`>",
        "TOKENIS_AUDIT_KEY": "<64 hex chars from `tokenis-mcp keygen-secret`>"
      }
    },
    "tokenis-demo": {
      "command": "uvx",
      "args": [
        "tokenis-mcp",
        "serve",
        "--demo"
      ]
    }
  }
}
